# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SECRET="generate-a-long-random-string-here"

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/scopusixteen?schema=public"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ORCID
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI="http://localhost:3000/api/auth/orcid/callback"
ORCID_ENV="sandbox"

# Object storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=scopusixteen-manuscripts
S3_REGION=auto
S3_PUBLIC_URL=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Scopusixteen Publishing <noreply@scopusixteen.com>"

# Crossref / DOI
DOI_PREFIX="10.5678"
CROSSREF_USERNAME=
CROSSREF_PASSWORD=
CROSSREF_DEPOSITOR_EMAIL="doi@scopusixteen.com"

# AI
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"

# Institutional IP access (JSON array)
# INSTITUTIONAL_IP_RANGES=[{"name":"Demo University","cidrs":["10.0.0.0/8"],"journalIds":["*"]}]
